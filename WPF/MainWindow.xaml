<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="Mozi alkalmazás" MinHeight="480" MinWidth="870" Height="480" Width="870" WindowStartupLocation="CenterScreen" Icon="film.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="1.5*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <!--Bal Oldal-->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Margin="2" FontSize="14" Text="Cím:"></TextBlock>
            <TextBox x:Name="TB_Cim"  Margin="2" FontSize="14"></TextBox>
            <TextBlock Margin="2" FontSize="14" Text="Hossz (perc):"></TextBlock>
            <TextBox x:Name="TB_Hossz" Margin="2" FontSize="14"></TextBox>
            <TextBlock Margin="2" FontSize="14" Text="Korhatár:"></TextBlock>
            <ComboBox x:Name="CB_Korhatar" Margin="2" FontSize="14"></ComboBox>
            <TextBlock Margin="2" FontSize="14" Text="Műfaj:"></TextBlock>
            <ComboBox x:Name="CB_Mufaj" Margin="2" FontSize="14"></ComboBox>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BT_Hozzaad" Margin="2" Width="100" FontSize="14" Content="Hozzáadás" Click="BT_Hozzaad_Click"></Button>
                <Button x:Name="BT_Modosit" Margin="2" Width="100" FontSize="14" Content="Módosítás" Click="BT_Modosit_Click"></Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BT_Torles" Margin="2" Width="100" FontSize="14" Content="Törlés" Click="BT_Torles_Click"></Button>
                <Button x:Name="BT_Frissit" Margin="2" Width="100" FontSize="14" Content="Frissítés" Click="BT_Frissit_Click"></Button>
            </StackPanel>
            <Line X1="0" Y1="5" X2="300" Y2="5" Stroke="Gray" StrokeThickness="1" Margin="0 5 0 5"></Line>
            <TextBlock FontSize="14" Text="Szűrés korhatár szerint:" FontWeight="Bold" Margin="2"></TextBlock>
            <RadioButton x:Name="RB_Osszes" GroupName="KorhatarSzures" IsChecked="True" Content="Összes" FontSize="14" Margin="2" VerticalContentAlignment="Center" Checked="RB_Checked"></RadioButton>
            <RadioButton x:Name="RB_KN" GroupName="KorhatarSzures" Content="KN" FontSize="14" Margin="2" VerticalContentAlignment="Center" Checked="RB_Checked"></RadioButton>
            <RadioButton x:Name="RB_6" GroupName="KorhatarSzures" Content="6" FontSize="14" Margin="2" VerticalContentAlignment="Center" Checked="RB_Checked"></RadioButton>
            <RadioButton x:Name="RB_12" GroupName="KorhatarSzures" Content="12" FontSize="14" Margin="2" VerticalContentAlignment="Center" Checked="RB_Checked"></RadioButton>
            <RadioButton x:Name="RB_16" GroupName="KorhatarSzures" Content="16" FontSize="14" Margin="2" VerticalContentAlignment="Center" Checked="RB_Checked"></RadioButton>
            <RadioButton x:Name="RB_18" GroupName="KorhatarSzures" Content="18" FontSize="14" Margin="2" VerticalContentAlignment="Center" Checked="RB_Checked"></RadioButton>
        </StackPanel>
        <!--Jobb Oldal-->
        <DataGrid Grid.Column="1" x:Name="DG_Filmek" Margin="5" SelectionChanged="DG_Filmek_SelectionChanged"></DataGrid>
    </Grid>
</Window>
